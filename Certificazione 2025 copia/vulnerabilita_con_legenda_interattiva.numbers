								resolve();
							}
						});
					}
					g_wacOwlHost = await (new Promise((resolve, reject) => {
						require(["odsp-next/roots/WacOwlHost"], function(wacOwlHostModule) {
							resolve(wacOwlHostModule.getWacOwlHost());
